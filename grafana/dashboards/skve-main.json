      "id": 3,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT coalesce(sum(mwh),0) FROM v_erloes WHERE ts::date = now()::date",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "MWh"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "title": "Letzter Datenstand",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT max(ts) FROM chp_schedule",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "none"
      }
    },
    {
      "title": "Strompreise: DAA / IDA / Prognose",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "id": 5,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT ts AS time, series AS metric, eur_mwh AS value\nFROM prices\nWHERE ts > now() - interval '7 days' AND $__timeFilter(ts)\nORDER BY ts",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Spot-Erlös je Motor (gestapelt)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "id": 6,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT ts AS time, name AS metric, erloes_eur AS value\nFROM v_erloes\nWHERE ts > now() - interval '3 days' AND $__timeFilter(ts)\nORDER BY ts",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR",
          "custom": {
            "drawStyle": "bars",
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 70
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Leistung je Motor",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "id": 7,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "time_series",
          "rawSql": "SELECT s.ts AS time, m.name AS metric, s.kw AS value\nFROM chp_schedule s JOIN chp_master m ON m.chp_id=s.chp_id\nWHERE s.ts > now() - interval '3 days' AND $__timeFilter(s.ts)\nORDER BY s.ts",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatt",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Jahresauslastung Hauptstandort (Grenze 2.190 MWh)",
      "type": "gauge",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "id": 8,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT sum(mwh)/2190.0*100 AS value\nFROM v_erloes\nWHERE section='Hauptstandort' AND date_part('year', ts)=date_part('year', now())",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "steps": [
              {
                "color": "green",
                "value": 0
              },
              {
                "color": "orange",
                "value": 85
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
