     "format": "table",
     "rawSql": "SELECT name AS \"Motor\",\n       round(sum(CASE WHEN kw>0 THEN 0.25 ELSE 0 END)::numeric,1) AS \"Stunden\",\n       round(sum(mwh)::numeric,2) AS \"MWh\",\n       round(coalesce(sum(erloes_eur),0)::numeric,2) AS \"Erlös €\",\n       round((coalesce(sum(erloes_eur),0)/NULLIF(sum(mwh),0))::numeric,2) AS \"€/MWh\"\nFROM v_erloes WHERE $__timeFilter(ts)\nGROUP BY name ORDER BY \"Erlös €\" DESC",
