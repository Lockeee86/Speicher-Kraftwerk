     "rawSql": "SELECT lpad(h::text,2,'0') AS \"Stunde\",\n  round(avg(CASE WHEN dow=1 THEN p END)::numeric,0) AS \"Mo\",\n  round(avg(CASE WHEN dow=2 THEN p END)::numeric,0) AS \"Di\",\n  round(avg(CASE WHEN dow=3 THEN p END)::numeric,0) AS \"Mi\",\n  round(avg(CASE WHEN dow=4 THEN p END)::numeric,0) AS \"Do\",\n  round(avg(CASE WHEN dow=5 THEN p END)::numeric,0) AS \"Fr\",\n  round(avg(CASE WHEN dow=6 THEN p END)::numeric,0) AS \"Sa\",\n  round(avg(CASE WHEN dow=0 THEN p END)::numeric,0) AS \"So\"\nFROM (\n  SELECT extract(hour from ts AT TIME ZONE 'Europe/Berlin')::int AS h,\n         extract(dow  from ts AT TIME ZONE 'Europe/Berlin')::int AS dow,\n         eur_mwh AS p\n  FROM prices WHERE series='DAA' AND $__timeFilter(ts)\n) t GROUP BY h ORDER BY h",
