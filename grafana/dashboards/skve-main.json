                "color": "red",
                "value": 100
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "title": "Monatserlös & Menge (Spot)",
      "type": "table",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 10,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT date_trunc('month', ts) AS \"Monat\",\n       round(sum(mwh)::numeric,0) AS \"MWh\",\n       round(sum(erloes_eur)::numeric,0) AS \"Erlös EUR\",\n       round((sum(erloes_eur)/nullif(sum(mwh),0))::numeric,2) AS \"EUR/MWh\"\nFROM v_erloes\nGROUP BY 1 ORDER BY 1 DESC",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ]
}