     },
     "format": "table",
     "rawSql": "SELECT 100.0*sum(CASE WHEN e.eur_mwh > (SELECT avg(eur_mwh) FROM prices WHERE series='DAA' AND $__timeFilter(ts)) THEN e.mwh ELSE 0 END)\n       / NULLIF(sum(e.mwh),0) AS value\nFROM v_erloes e WHERE $__timeFilter(e.ts)",
