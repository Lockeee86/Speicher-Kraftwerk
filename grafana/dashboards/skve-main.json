     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "skve-tsdb"
     },
     "format": "table",
     "rawSql": "SELECT avg(abs(a.eur_mwh-f.eur_mwh)) AS value\nFROM prices a JOIN prices f ON a.ts=f.ts AND f.series='FORECAST_DAA'\nWHERE a.series='DAA' AND $__timeFilter(a.ts)",
