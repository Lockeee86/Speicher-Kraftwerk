     },
     "format": "table",
     "rawSql": "SELECT m.name AS \"Motor\", round((sum(e.mwh)/(m.nenn_kw/1000.0))::numeric,0) AS \"Volllaststunden\"\nFROM v_erloes e JOIN chp_master m ON m.chp_id=e.chp_id\nWHERE date_part('year', e.ts)=date_part('year', now())\nGROUP BY m.name, m.nenn_kw ORDER BY 2 DESC",
     "rawQuery": true
    }
