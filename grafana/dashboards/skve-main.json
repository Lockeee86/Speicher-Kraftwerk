{
  "title": "SKVE – BGA Ribbesbüttel",
  "uid": "skve-main",
  "tags": [
    "skve",
    "biogas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30m",
  "time": {
    "from": "now-7d",
    "to": "now+2d"
  },
  "panels": [
    {
      "title": "Ø DAA-Preis (7 Tage)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT avg(eur_mwh) FROM prices WHERE series='DAA' AND ts > now() - interval '7 days'",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "title": "Erlös heute (Spot, alle Motoren)",
      "type": "stat",
      "datasource": {
        "type": "postgres",
        "uid": "skve-tsdb"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "skve-tsdb"
          },
          "format": "table",
          "rawSql": "SELECT coalesce(sum(erloes_eur),0) FROM v_erloes WHERE ts::date = now()::date",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyEUR"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      }
    },
    {
      "title": "Erzeugung heute",
