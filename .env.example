# === SKVE Collector – Umgebungsvariablen ===
# Diese Werte in Portainer unter "Environment variables" setzen.
# Diese Datei NICHT mit echten Werten ins Git committen – nur als Vorlage.

# --- Pflicht ---
SKVE_API_KEY=DEIN_API_KEY_HIER
DB_PASSWORD=ein-sicheres-db-passwort
GF_ADMIN_PASSWORD=ein-sicheres-grafana-passwort

# --- Optional (Defaults sind meist ok) ---
DB_NAME=skve
DB_USER=skve
GF_ADMIN_USER=admin
GF_PORT=3000

SKVE_API_BASE=https://www.speicher-kraftwerk.de/api
SKVE_CHP_IDS=499,500,501,502
SKVE_PRICE_SERIES=DAA,IDA
SKVE_FORECAST_MARKETS=DAA

# Gasspeicher-Füllstand (%): Anlagen-ID aus der URL
# /api/module/gas-storage/<ID>/gas-storages  (leer = deaktiviert)
# HINWEIS: Dieser Endpunkt ist NICHT über den x-api-key erreichbar (liefert 401);
# er hängt an der Web-App-Anmeldung (Session/Bearer). Daher standardmäßig aus.
# SKVE_GAS_STORAGE_ID=165
GAS_LOOKBACK_DAYS=3

# Lauf-Intervall in Sekunden (86400 = täglich)
RUN_INTERVAL_SEC=86400
# true = einmal laufen und beenden (für externen Cron statt Dauerschleife)
RUN_ONCE=false

# Nachhol-Verhalten
OVERLAP_HOURS=6
FUTURE_HORIZON_DAYS=7
BACKFILL_FALLBACK_DAYS=3
# Optionaler einmaliger Backfill-Start beim allerersten Lauf (leer lassen für normalen Betrieb):
# SKVE_INITIAL_START_DATE=2026-01-01

# --- Historischer Backfill ---
# Große Zeiträume werden automatisch in Stücke von MAX_CHUNK_DAYS zerlegt
# (die API liefert mehr als ~1 Monat am Stück nicht zuverlässig).
MAX_CHUNK_DAYS=14
# Kurze Pause zwischen den Chunks (Sekunden), schont die API.
CHUNK_PAUSE_SEC=0.5
# EINMALIGER Backfill ab Datum: setzen, Stack neu deployen, durchlaufen lassen,
# danach wieder leeren/entfernen. Ignoriert den gespeicherten Fortschritt und
# lädt idempotent alles ab diesem Datum (z. B. das ganze Jahr 2026):
# SKVE_BACKFILL_FROM=2026-01-01

# === KI-Wochenreport (reporter) ===
# Wochenrückblick: letzte Kalenderwoche + letzte 4 Wochen (Trend).
# Zeitzone + Wochentag(e) (Mo=0 … So=6, mehrere kommagetrennt) + Uhrzeit.
# Beispiel Mo/Mi/Fr: REPORT_WEEKDAY=0,2,4
TZ=Europe/Berlin
REPORT_WEEKDAY=0
REPORT_HOUR=8
REPORT_MINUTE=0
# Zum Testen einmal sofort laufen lassen (danach wieder auf false):
# REPORT_RUN_ONCE=true

# Claude-API-Key (Pflicht für den Report): https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-DEIN_KEY_HIER
# Modell + Aufwand (Kosten pro Report sind minimal):
REPORT_MODEL=claude-opus-5
REPORT_EFFORT=medium
# Optionale Preisschwelle (€/MWh), ab der sich Produktion lohnt (leer = Claude schätzt):
# REPORT_PRICE_THRESHOLD=80
# Fester Hinweis unter jedem Report (leer = kein Hinweis). Default ist der Spot-Hinweis:
# REPORT_DISCLAIMER=⚠️ Hinweis: "Spot" = reiner Börsen-Rohertrag (DAA), nicht der tatsächliche Erlös (EEG-Vergütung + Flexprämie sind nicht enthalten).

# --- Zustellung: Telegram (empfohlen, einfach) ---
# Bot bei @BotFather anlegen -> Token; Chat-ID via @userinfobot:
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# --- Zustellung: MS Teams (alternativ, Incoming Webhook) ---
# In Teams: Kanal -> ... -> "Workflows" -> Vorlage "Beim Empfang einer
# Webhookanfrage in einem Kanal posten" -> URL kopieren:
# TEAMS_WEBHOOK_URL=https://prod-XX.westeurope.logic.azure.com:443/workflows/...

# --- Zustellung: E-Mail (alternativ) ---
# SMTP_HOST=smtp.deinanbieter.de
# SMTP_PORT=587
# SMTP_USER=postfach@example.de
# SMTP_PASSWORD=dein-smtp-passwort
# MAIL_FROM=postfach@example.de
# MAIL_TO=du@example.de
