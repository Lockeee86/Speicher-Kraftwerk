# === SKVE Collector – Umgebungsvariablen ===
# Diese Werte in Portainer unter "Environment variables" setzen.
# Diese Datei NICHT mit echten Werten ins Git committen – nur als Vorlage.

# --- Pflicht ---
SKVE_API_KEY=DEIN_API_KEY_HIER
DB_PASSWORD=ein-sicheres-db-passwort
GF_ADMIN_PASSWORD=ein-sicheres-grafana-passwort

# --- Optional (Defaults sind meist ok) ---
DB_NAME=skve
DB_USER=skve
GF_ADMIN_USER=admin
GF_PORT=3000

SKVE_API_BASE=https://www.speicher-kraftwerk.de/api
SKVE_CHP_IDS=499,500,501,502
SKVE_PRICE_SERIES=DAA,IDA
SKVE_FORECAST_MARKETS=DAA

# Lauf-Intervall in Sekunden (86400 = täglich)
RUN_INTERVAL_SEC=86400
# true = einmal laufen und beenden (für externen Cron statt Dauerschleife)
RUN_ONCE=false

# Nachhol-Verhalten
OVERLAP_HOURS=6
FUTURE_HORIZON_DAYS=2
BACKFILL_FALLBACK_DAYS=3
# Optionaler einmaliger Backfill-Start beim allerersten Lauf (leer lassen für normalen Betrieb):
# SKVE_INITIAL_START_DATE=2026-01-01

# --- Historischer Backfill ---
# Große Zeiträume werden automatisch in Stücke von MAX_CHUNK_DAYS zerlegt
# (die API liefert mehr als ~1 Monat am Stück nicht zuverlässig).
MAX_CHUNK_DAYS=14
# Kurze Pause zwischen den Chunks (Sekunden), schont die API.
CHUNK_PAUSE_SEC=0.5
# EINMALIGER Backfill ab Datum: setzen, Stack neu deployen, durchlaufen lassen,
# danach wieder leeren/entfernen. Ignoriert den gespeicherten Fortschritt und
# lädt idempotent alles ab diesem Datum (z. B. das ganze Jahr 2026):
# SKVE_BACKFILL_FROM=2026-01-01
